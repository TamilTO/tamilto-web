# Copy this file to .env.local for your own computer. On Netlify, add the same names under
# Project configuration → Environment variables. Never commit real values to GitHub.

# Public site address (no trailing slash): canonical URLs, share previews, sitemap
NEXT_PUBLIC_SITE_URL=https://tamilto.com

# Supabase: database, logins and photo storage (checklist steps 15–21)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRET: server only

# Admin panel → live site refresh (any random 32+ characters)
REVALIDATE_SECRET=                    # SECRET

# Email for quote requests and claim alerts (Resend, checklist step 20)
RESEND_API_KEY=                       # SECRET
EMAIL_FROM="TamilTO <hello@tamilto.com>"
ADMIN_EMAIL=hello@tamilto.com         # where new quote requests, claims and tips are announced

# Optional: extra secret mixed into the daily visitor code (defaults to REVALIDATE_SECRET)
ACTIVITY_SALT=

# Newsletter: beehiiv | mailchimp | convertkit (optional at launch)
NEWSLETTER_PROVIDER=beehiiv
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Analytics (Plausible, cookie-free; optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Ads (optional). Loaded only after cookie consent. Empty = house ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=
NEXT_PUBLIC_AD_SLOT_RECT=
NEXT_PUBLIC_AD_SLOT_INFEED=
